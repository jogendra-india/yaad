<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer. The inbox key never leaves the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync.xml" />
    </device-transfer>
</data-extraction-rules>
